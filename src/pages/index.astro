---
import InteractiveCard from '../components/react/InteractiveCard.jsx';
import Scene from '../components/react/Scene.jsx';
---
<html lang="en">
<head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>iStudio Generative 3D</title>
    <link rel="stylesheet" href="/src/styles/global.css" />
    <link rel="stylesheet" href="/src/styles/effects.css" />
    <script src="/src/scripts/engine.js" type="module"></script>
</head>
<body>
    <Scene client:load>
        {/* The page-section divs are now the direct children for easier styling */}
        <div class="page-section" data-section-coord="0,0">
            <div class="content-wrapper">
                <img id="main-logo" src="" alt="Logo" style={{display: 'none'}} />
                <h1 id="main-title"></h1>
                <p id="main-subtitle" class="subtitle"></p>
                <div class="typewriter-container">
                    <span>&gt; </span><span id="typewriter"></span>
                </div>
            </div>
        </div>

        <div class="page-section" data-section-coord="0,1">
             <div class="content-wrapper">
                <h2>Core Services</h2>
                <div class="services-grid">
                    <InteractiveCard title="AI-Powered Code" description="Generate robust and efficient code with our advanced AI." />
                    <InteractiveCard title="3D Environments" description="Create immersive and dynamic 3D worlds for your users." />
                    <InteractiveCard title="Dynamic UI/UX" description="Design interfaces that adapt, evolve, and feel alive." />
                </div>
            </div>
        </div>

        <div class="page-section" data-section-coord="1,1">
            <div class="content-wrapper">
                <h2>Project Showcase</h2>
                <p class="subtitle">Here we can feature a gallery of 3D projects.</p>
            </div>
        </div>
    </Scene>

    <div class="mobile-nav">
        <button id="prev-section-btn" class="nav-button">Prev</button>
        <button id="next-section-btn" class="nav-button">Next</button>
    </div>
</body>
</html>
