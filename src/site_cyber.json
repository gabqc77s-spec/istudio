{
  "pagina_principal": {
    "display": "flex",
    "flex-direction": "column",
    "align-items": "center",
    "justify-content": "center",
    "min-height": "100vh",
    "background": "radial-gradient(circle at center, #0a0a2e 0%, #030014 100%)",
    "overflow": "hidden",
    "perspective": "1200px",

    "red_neuronal_fondo": {
      "position": "absolute",
      "top": "0",
      "left": "0",
      "width": "100%",
      "height": "100%",
      "pointer-events": "none",
      "transform-style": "preserve-3d",
      "auto-animate": { "rotate-y": 0.05, "rotate-x": 0.02 },

      "nodo_procedural": {
        "instancias": {
          "cantidad": 40,
          "spread": { "x": 2000, "y": 2000, "z": 1000 },
          "scale": { "min": 0.5, "max": 2 }
        },
        "width": "4px",
        "height": "4px",
        "background": "#0ea5e9",
        "border-radius": "50%",
        "box-shadow": "0 0 15px #0ea5e9",
        "opacity": "0.6"
      }
    },

    "panel_central": {
      "position": "relative",
      "padding": "60px",
      "background": "rgba(15, 23, 42, 0.6)",
      "backdrop-filter": "blur(30px)",
      "-webkit-backdrop-filter": "blur(30px)",
      "border": "1px solid rgba(14, 165, 233, 0.3)",
      "border-radius": "32px",
      "display": "flex",
      "flex-direction": "column",
      "align-items": "center",
      "gap": "20px",
      "transform-style": "preserve-3d",
      "look-at-mouse": { "maxRotation": 10, "lerp": 0.1 },
      "box-shadow": "0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 40px rgba(14, 165, 233, 0.1)",

      "badge": {
        "text": "SYSTEM STATUS: OPTIMIZED",
        "font-size": "10px",
        "font-weight": "800",
        "color": "#0ea5e9",
        "letter-spacing": "0.2em",
        "padding": "6px 16px",
        "background": "rgba(14, 165, 233, 0.1)",
        "border": "1px solid rgba(14, 165, 233, 0.3)",
        "border-radius": "20px",
        "margin-bottom": "10px",
        "transform": "translateZ(20px)"
      },

      "titulo_cyber": {
        "texto": "NEURO<span style='color: #a855f7;'>CYBER</span>",
        "font-size": "5rem",
        "font-weight": "900",
        "letter-spacing": "-0.05em",
        "color": "white",
        "text-shadow": "0 0 30px rgba(14, 165, 233, 0.5)",
        "transform": "translateZ(50px)",
        "mouse-follow": { "factor": 0.05, "lerp": 0.1 }
      },

      "subtitulo": {
        "texto": "Arquitectura de datos inmersiva v4.0",
        "font-size": "1.2rem",
        "color": "#94a3b8",
        "transform": "translateZ(30px)"
      },

      "separador": {
        "width": "100px",
        "height": "2px",
        "background": "linear-gradient(90deg, transparent, #0ea5e9, transparent)",
        "margin": "20px 0"
      },

      "controles": {
        "display": "flex",
        "gap": "15px",
        "transform": "translateZ(40px)",

        "boton_primario": {
          "texto": "INICIAR PROTOCOLO",
          "padding": "12px 24px",
          "background": "#0ea5e9",
          "color": "white",
          "font-weight": "700",
          "font-size": "12px",
          "border-radius": "8px",
          "cursor": "pointer",
          "transition": "all 0.3s ease",
          "hover": {
            "transform": "scale(1.05) translateZ(10px)",
            "box-shadow": "0 0 20px rgba(14, 165, 233, 0.6)"
          }
        },

        "boton_secundario": {
          "texto": "ANALIZAR NODOS",
          "padding": "12px 24px",
          "background": "transparent",
          "border": "1px solid #0ea5e9",
          "color": "#0ea5e9",
          "font-weight": "700",
          "font-size": "12px",
          "border-radius": "8px",
          "cursor": "pointer",
          "transition": "all 0.3s ease",
          "hover": {
            "background": "rgba(14, 165, 233, 0.1)",
            "transform": "scale(1.05) translateZ(10px)"
          }
        }
      }
    },

    "decoracion_flotante": {
      "position": "absolute",
      "width": "100%",
      "height": "100%",
      "pointer-events": "none",
      "transform-style": "preserve-3d",

      "aro_1": {
        "position": "absolute",
        "top": "50%",
        "left": "50%",
        "width": "600px",
        "height": "600px",
        "border": "1px dashed rgba(168, 85, 247, 0.3)",
        "border-radius": "50%",
        "transform": "translate(-50%, -50%) rotateX(70deg)",
        "auto-animate": { "rotate-z": 0.5 }
      },

      "aro_2": {
        "position": "absolute",
        "top": "50%",
        "left": "50%",
        "width": "500px",
        "height": "500px",
        "border": "1px solid rgba(14, 165, 233, 0.2)",
        "border-radius": "50%",
        "transform": "translate(-50%, -50%) rotateY(70deg)",
        "auto-animate": { "rotate-z": -0.3 }
      }
    }
  }
}
