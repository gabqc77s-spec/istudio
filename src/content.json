{
    "pagina_principal": {
        "nombre": "Impulsa V4 — Professional Multiverse OS",
        "display": "flex",
        "flex-direction": "column",
        "width": "100%",
        "min-height": "100vh",
        "perspective": "2500px",
        "transform-style": "preserve-3d",
        "background": "#030014",
        "overflow": "hidden",

        "SISTEMA_NAVEGACION": {
            "nombre": "Global Navigation OS",
            "position": "fixed",
            "bottom": "40px",
            "width": "100%",
            "display": "flex",
            "justify-content": "center",
            "z-index": "10000",

            "dock": {
                "display": "flex",
                "gap": "1rem",
                "padding": "12px 24px",
                "background": "rgba(10, 10, 20, 0.7)",
                "backdrop-filter": "blur(20px) saturate(180%)",
                "border": "1px solid rgba(255, 255, 255, 0.1)",
                "border-radius": "100px",
                "box-shadow": "0 20px 50px rgba(0,0,0,0.5), inset 0 0 20px rgba(255,255,255,0.05)",
                "align-items": "center",

                "nav_1": {
                    "texto": "🏢 STRATEGY", "cursor": "pointer", "padding": "10px 20px", "border-radius": "20px", "transition": "all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1)", "font-size": "12px", "font-weight": "600", "letter-spacing": "1px",
                    "hover": { "background": "rgba(255,255,255,0.1)", "transform": "translateY(-5px) scale(1.05)", "box-shadow": "0 10px 20px rgba(0,0,0,0.3)" },
                    "acciones": { "click": { "tipo": "navegacion", "desde": "pagina_principal.UNIVERSOS", "hacia": "pagina_principal.UNIVERSOS.Web_Corporativa", "efecto": "slide" } }
                },
                "nav_2": {
                    "texto": "🧪 RESEARCH", "cursor": "pointer", "padding": "10px 20px", "border-radius": "20px", "transition": "all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1)", "font-size": "12px", "font-weight": "600", "letter-spacing": "1px",
                    "hover": { "background": "rgba(255,255,255,0.1)", "transform": "translateY(-5px) scale(1.05)", "box-shadow": "0 10px 20px rgba(0,0,0,0.3)" },
                    "acciones": { "click": { "tipo": "navegacion", "desde": "pagina_principal.UNIVERSOS", "hacia": "pagina_principal.UNIVERSOS.Web_Laboratorio", "efecto": "slide" } }
                },
                "nav_3": {
                    "texto": "💎 SHOWCASE", "cursor": "pointer", "padding": "10px 20px", "border-radius": "20px", "transition": "all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1)", "font-size": "12px", "font-weight": "600", "letter-spacing": "1px",
                    "hover": { "background": "rgba(255,255,255,0.1)", "transform": "translateY(-5px) scale(1.05)", "box-shadow": "0 10px 20px rgba(0,0,0,0.3)" },
                    "acciones": { "click": { "tipo": "navegacion", "desde": "pagina_principal.UNIVERSOS", "hacia": "pagina_principal.UNIVERSOS.Web_Showcase_3D", "efecto": "slide" } }
                },
                "nav_4": {
                    "texto": "💳 FINTECH", "cursor": "pointer", "padding": "10px 20px", "border-radius": "20px", "transition": "all 0.4s cubic-bezier(0.2, 0.8, 0.2, 1)", "font-size": "12px", "font-weight": "600", "letter-spacing": "1px",
                    "hover": { "background": "rgba(255,255,255,0.1)", "transform": "translateY(-5px) scale(1.05)", "box-shadow": "0 10px 20px rgba(0,0,0,0.3)" },
                    "acciones": { "click": { "tipo": "navegacion", "desde": "pagina_principal.UNIVERSOS", "hacia": "pagina_principal.UNIVERSOS.Web_App_Mobile", "efecto": "slide" } }
                }
            }
        },

        "UNIVERSOS": {
            "nombre": "Contenedor de Realidades",
            "width": "100%",
            "height": "100vh",
            "position": "relative",
            "transform-style": "preserve-3d",

            "Web_Corporativa": {
                "nombre": "NEXUS STRATEGY & DESIGN",
                "display": "flex",
                "flex-direction": "column",
                "width": "100%",
                "min-height": "100vh",
                "background": "linear-gradient(to bottom, #030014, #0a0a20)",
                "transition": "all 1.2s cubic-bezier(0.23, 1, 0.32, 1)",
                "opacity": "1",
                "padding": "0",
                "overflow-y": "auto",
                "scroll": { "direccion": "vertical" },

                "HERO_SECTION": {
                    "width": "100%", "height": "100vh", "display": "flex", "flex-direction": "column", "align-items": "center", "justify-content": "center",
                    "transform-style": "preserve-3d", "position": "relative",

                    "BG_ELEMENTS": {
                        "position": "absolute", "width": "100%", "height": "100%", "pointer-events": "none", "transform-style": "preserve-3d",
                        "BLUR_ORB": {
                            "position": "absolute", "width": "600px", "height": "600px", "background": "radial-gradient(circle, rgba(168, 85, 247, 0.15), transparent 70%)",
                            "border-radius": "50%", "filter": "blur(60px)", "transform": "translateZ(-500px) translate3d(-30%, -20%, 0)",
                            "auto-animar": { "tipo": "flotar", "intensidad": 50, "duracion": 5 }
                        }
                    },

                    "TITLE_WRAP": {
                        "transform-style": "preserve-3d", "display": "flex", "flex-direction": "column", "align-items": "center",
                        "main_title": {
                            "texto": "NEXUS <span style='background: linear-gradient(90deg, #fff, #a855f7); -webkit-background-clip: text; -webkit-text-fill-color: transparent;'>STUDIO</span>",
                            "font-size": "10rem", "font-weight": "900", "letter-spacing": "-8px", "color": "#fff", "line-height": "0.9",
                            "look-at": { "intensidad": 25 }, "transform": "translateZ(300px)"
                        },
                        "sub_title": {
                            "texto": "Arquitectura Digital de Siguiente Generación",
                            "font-size": "1.2rem", "color": "rgba(255,255,255,0.5)", "margin-top": "30px", "letter-spacing": "5px", "text-transform": "uppercase",
                            "escribir": { "velocidad": 60, "retraso": 800 }, "transform": "translateZ(150px)"
                        }
                    }
                },

                "BENTO_GRID": {
                    "display": "grid", "grid-template-columns": "repeat(12, 1fr)", "grid-auto-rows": "280px", "gap": "24px", "width": "90%", "max-width": "1600px", "margin": "100px auto",
                    "transform-style": "preserve-3d",

                    "CARD_STRATEGY": {
                        "grid-column": "span 8", "grid-row": "span 2", "background": "rgba(255,255,255,0.02)", "border": "1px solid rgba(255,255,255,0.05)", "border-radius": "40px", "padding": "60px",
                        "display": "flex", "flex-direction": "column", "justify-content": "flex-end", "cursor": "pointer", "transition": "all 0.6s cubic-bezier(0.16, 1, 0.3, 1)", "overflow": "hidden",
                        "hover-hermanos": { "opacity": "0.3", "filter": "blur(10px)", "transform": "scale(0.95) translateZ(-100px)" },
                        "hover": { "background": "rgba(255,255,255,0.05)", "border-color": "rgba(168, 85, 247, 0.5)", "transform": "scale(1.02) translateZ(50px)" },

                        "label": { "texto": "01", "font-size": "14px", "color": "#a855f7", "font-weight": "bold", "margin-bottom": "20px" },
                        "titulo": { "texto": "Visión Inmersiva", "font-size": "3rem", "font-weight": "800", "color": "#fff" },
                        "desc": { "texto": "Creamos experiencias que trascienden la pantalla plana tradicional.", "font-size": "1.1rem", "color": "rgba(255,255,255,0.4)", "margin-top": "20px", "max-width": "400px" }
                    },

                    "CARD_DESIGN": {
                        "grid-column": "span 4", "grid-row": "span 2", "background": "linear-gradient(135deg, #a855f7, #6366f1)", "border-radius": "40px", "padding": "40px",
                        "display": "flex", "flex-direction": "column", "align-items": "center", "justify-content": "center", "cursor": "pointer", "transition": "all 0.6s cubic-bezier(0.16, 1, 0.3, 1)",
                        "tilt": { "max": 15 }, "hover-hermanos": { "opacity": "0.3", "filter": "blur(10px)", "transform": "scale(0.95)" },

                        "icon": { "texto": "✦", "font-size": "5rem", "color": "#fff" },
                        "txt": { "texto": "Diseño Espacial", "font-size": "1.5rem", "font-weight": "bold", "margin-top": "20px" }
                    }
                }
            },

            "Web_Laboratorio": {
                "nombre": "COGNITIVE RESEARCH LAB",
                "display": "none", "flex-direction": "column", "width": "100%", "min-height": "100vh", "background": "#000", "transition": "all 1s", "opacity": "0", "align-items": "center", "justify-content": "center", "overflow": "hidden",

                "DATA_CORE_WRAPPER": {
                    "width": "100%", "height": "100vh", "display": "flex", "align-items": "center", "justify-content": "center", "position": "relative", "transform-style": "preserve-3d",

                    "CORE_ORB": {
                        "width": "500px", "height": "500px", "background": "radial-gradient(circle, #0ea5e9 0%, transparent 70%)", "border-radius": "50%", "display": "flex", "align-items": "center", "justify-content": "center",
                        "magnetico": { "fuerza": 0.8, "radio": 800 }, "position": "relative", "z-index": "2",
                        "audio": { "url": "https://www.soundjay.com/buttons/sounds/button-20.mp3", "evento": "mouseenter", "volumen": 0.2 },

                        "INNER_CHIP": {
                            "width": "100px", "height": "100px", "background": "#fff", "box-shadow": "0 0 100px #0ea5e9", "border-radius": "10px", "look-at": { "intensidad": 60 },
                            "auto-animar": { "tipo": "latir", "intensidad": 20 }
                        }
                    },

                    "PARTICLE_SYSTEM": {
                        "position": "absolute", "width": "100%", "height": "100%", "pointer-events": "none",
                        "instancias": {
                            "cantidad": 40,
                            "plantilla": {
                                "width": "2px", "height": "2px", "background": "#0ea5e9", "position": "absolute", "top": "50%", "left": "50%", "opacity": "0.5",
                                "auto-animar": { "tipo": "flotar", "intensidad": 300, "duracion": 10 }
                            },
                            "variacion": { "top": 500, "left": 800, "opacity": 0.5 }
                        }
                    }
                },

                "TERMINAL_FEED": {
                    "position": "fixed", "top": "40px", "left": "40px", "width": "300px", "font-family": "monospace", "font-size": "12px", "color": "#0ea5e9", "opacity": "0.7",
                    "line_1": { "texto": "> INITIALIZING NEURAL_SYNC...", "escribir": { "velocidad": 30 } },
                    "line_2": { "texto": "> CORE TEMPERATURE: OPTIMAL", "margin-top": "10px", "escribir": { "velocidad": 30, "retraso": 1000 } },
                    "line_3": { "texto": "> DATA STREAMS: ACTIVE", "margin-top": "10px", "escribir": { "velocidad": 30, "retraso": 2000 } }
                }
            },

            "Web_Showcase_3D": {
                "nombre": "AERO X SHOWCASE",
                "display": "none", "flex-direction": "column", "width": "100%", "min-height": "100vh", "background": "#050505", "transition": "all 1s", "opacity": "0", "align-items": "center", "justify-content": "center",

                "PRODUCT_STAGE": {
                    "perspective": "3000px", "transform-style": "preserve-3d", "width": "100%", "height": "100vh", "display": "flex", "align-items": "center", "justify-content": "center",

                    "HARDWARE_UNIT": {
                        "width": "400px", "height": "600px", "position": "relative", "transform-style": "preserve-3d",
                        "transform": "rotateY(-20deg) rotateX(10deg)", "transition": "transform 1.5s cubic-bezier(0.16, 1, 0.3, 1)",
                        "hover": { "transform": "rotateY(0deg) rotateX(0deg) translateZ(100px)" },

                        "CHASSIS": {
                            "position": "absolute", "width": "100%", "height": "100%", "background": "#111", "border": "2px solid #333", "border-radius": "20px", "transform": "translateZ(0px)", "transition": "all 1s cubic-bezier(0.16, 1, 0.3, 1)"
                        },
                        "SCREEN_PLATE": {
                            "position": "absolute", "width": "90%", "height": "90%", "top": "5%", "left": "5%", "background": "rgba(255,255,255,0.02)", "backdrop-filter": "blur(10px)", "border": "1px solid rgba(255,255,255,0.1)", "border-radius": "15px", "transform": "translateZ(50px)", "transition": "all 1s cubic-bezier(0.16, 1, 0.3, 1)", "display": "flex", "align-items": "center", "justify-content": "center",
                            "texto": "AERO X — PANEL"
                        },
                        "CORE_COMPONENTS": {
                            "position": "absolute", "width": "70%", "height": "50%", "top": "25%", "left": "15%", "background": "linear-gradient(45deg, #111, #222)", "border": "1px solid #444", "transform": "translateZ(-50px)", "transition": "all 1s cubic-bezier(0.16, 1, 0.3, 1)", "display": "flex", "flex-direction": "column", "padding": "20px",
                            "chip": { "width": "40px", "height": "40px", "background": "#6366f1", "box-shadow": "0 0 20px #6366f1" }
                        }
                    }
                },

                "EXPLODE_CONTROL": {
                    "position": "fixed", "right": "80px", "display": "flex", "flex-direction": "column", "gap": "20px",
                    "btn_explode": {
                        "texto": "VIEW EXPLODED", "padding": "15px 30px", "background": "transparent", "border": "1px solid #fff", "color": "#fff", "cursor": "pointer", "transition": "all 0.3s",
                        "acciones": {
                            "click": [
                                { "target": "pagina_principal.UNIVERSOS.Web_Showcase_3D.PRODUCT_STAGE.HARDWARE_UNIT.SCREEN_PLATE", "estilos": { "transform": "translateZ(250px)", "opacity": "0.5" } },
                                { "target": "pagina_principal.UNIVERSOS.Web_Showcase_3D.PRODUCT_STAGE.HARDWARE_UNIT.CORE_COMPONENTS", "estilos": { "transform": "translateZ(-150px)", "opacity": "0.8" } }
                            ]
                        },
                        "hover": { "background": "#fff", "color": "#000" },
                        "audio": { "url": "https://www.soundjay.com/buttons/sounds/button-16.mp3", "volumen": 0.3 }
                    },
                    "btn_reset": {
                        "texto": "ASSEMBLE", "padding": "15px 30px", "background": "transparent", "border": "1px solid rgba(255,255,255,0.3)", "color": "rgba(255,255,255,0.3)", "cursor": "pointer", "transition": "all 0.3s",
                        "acciones": {
                            "click": [
                                { "target": "pagina_principal.UNIVERSOS.Web_Showcase_3D.PRODUCT_STAGE.HARDWARE_UNIT.SCREEN_PLATE", "estilos": { "transform": "translateZ(50px)", "opacity": "1" } },
                                { "target": "pagina_principal.UNIVERSOS.Web_Showcase_3D.PRODUCT_STAGE.HARDWARE_UNIT.CORE_COMPONENTS", "estilos": { "transform": "translateZ(-50px)", "opacity": "1" } }
                            ]
                        }
                    }
                }
            },

            "Web_App_Mobile": {
                "nombre": "QUANTUM FINANCE OS",
                "display": "none", "flex-direction": "column", "width": "100%", "min-height": "100vh", "background": "#0a0a0a", "transition": "all 1s", "opacity": "0", "align-items": "center", "justify-content": "center",

                "DEVICE_FRAME": {
                    "width": "380px", "height": "780px", "background": "#000", "border-radius": "50px", "border": "12px solid #1a1a1a", "position": "relative", "overflow": "hidden", "box-shadow": "0 50px 100px rgba(0,0,0,0.8)",

                    "APP_SCREENS": {
                        "width": "100%", "height": "100%", "position": "relative",

                        "DASHBOARD": {
                            "width": "100%", "height": "100%", "background": "#000", "display": "flex", "flex-direction": "column", "padding": "40px 25px", "transition": "all 0.6s cubic-bezier(0.2, 0.8, 0.2, 1)",

                            "header": { "texto": "Good Morning, Gabriel", "font-size": "14px", "color": "rgba(255,255,255,0.4)" },
                            "balance": { "texto": "$42,500.00", "font-size": "2.5rem", "font-weight": "800", "margin-top": "10px", "color": "#fff" },

                            "CHART_SIM": {
                                "width": "100%", "height": "180px", "margin-top": "30px", "display": "flex", "align-items": "flex-end", "gap": "10px",
                                "bar_1": { "width": "20%", "height": "40%", "background": "#3b82f6", "border-radius": "10px", "auto-animar": { "tipo": "latir", "intensidad": 5 } },
                                "bar_2": { "width": "20%", "height": "70%", "background": "#6366f1", "border-radius": "10px", "auto-animar": { "tipo": "latir", "intensidad": 8, "duracion": 4 } },
                                "bar_3": { "width": "20%", "height": "55%", "background": "#a855f7", "border-radius": "10px", "auto-animar": { "tipo": "latir", "intensidad": 6, "duracion": 2.5 } }
                            },

                            "NAV_CARDS": {
                                "margin-top": "40px", "display": "flex", "flex-direction": "column", "gap": "15px",
                                "card_tx": {
                                    "texto": "View Transactions", "padding": "20px", "background": "rgba(255,255,255,0.05)", "border-radius": "20px", "cursor": "pointer",
                                    "hover": { "background": "rgba(255,255,255,0.1)" },
                                    "acciones": { "click": { "tipo": "navegacion", "desde": "pagina_principal.UNIVERSOS.Web_App_Mobile.DEVICE_FRAME.APP_SCREENS", "hacia": "pagina_principal.UNIVERSOS.Web_App_Mobile.DEVICE_FRAME.APP_SCREENS.TRANSACTIONS", "efecto": "slide" } }
                                }
                            }
                        },

                        "TRANSACTIONS": {
                            "width": "100%", "height": "100%", "background": "#050505", "display": "none", "opacity": "0", "transform": "translateX(100%)", "flex-direction": "column", "padding": "40px 25px", "transition": "all 0.6s cubic-bezier(0.2, 0.8, 0.2, 1)",

                            "back": {
                                "texto": "← Back", "color": "#a855f7", "cursor": "pointer", "margin-bottom": "30px",
                                "acciones": { "click": { "tipo": "navegacion", "desde": "pagina_principal.UNIVERSOS.Web_App_Mobile.DEVICE_FRAME.APP_SCREENS", "hacia": "pagina_principal.UNIVERSOS.Web_App_Mobile.DEVICE_FRAME.APP_SCREENS.DASHBOARD", "efecto": "slide" } }
                            },
                            "title": { "texto": "Recent History", "font-size": "1.5rem", "font-weight": "bold" },
                            "tx_list": [
                                { "texto": "Apple Store - $199.00", "padding": "15px 0", "border-bottom": "1px solid #111" },
                                { "texto": "Starbucks - $5.50", "padding": "15px 0", "border-bottom": "1px solid #111" },
                                { "texto": "Amazon - $42.10", "padding": "15px 0", "border-bottom": "1px solid #111" }
                            ]
                        }
                    }
                }
            }
        }
    }
}
