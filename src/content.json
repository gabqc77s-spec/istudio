{
    "pagina_principal": {
        "nombre": "Impulsa V4 — Unified Digital Future Agency",
        "display": "flex",
        "flex-direction": "column",
        "width": "100%",
        "min-height": "100vh",
        "perspective": "2500px",
        "transform-style": "preserve-3d",
        "background": "#030014",
        "color": "#fff",
        "font-family": "Inter, system-ui, sans-serif",
        "overflow-x": "hidden",

        "BACKGROUND_LAYERS": {
            "position": "fixed", "top": "0", "left": "0", "width": "100%", "height": "100%", "pointer-events": "none", "z-index": "-1",
            "RADIAL_GLOW": {
                "position": "absolute", "width": "150%", "height": "150%", "top": "-25%", "left": "-25%",
                "background": "radial-gradient(circle at 50% 50%, rgba(14, 165, 233, 0.05) 0%, transparent 70%)",
                "auto-animar": { "tipo": "latir", "intensidad": 10, "duracion": 10 }
            },
            "PARTICLES": {
                "position": "absolute", "width": "100%", "height": "100%",
                "instancias": {
                    "cantidad": 50,
                    "plantilla": {
                        "width": "2px", "height": "2px", "background": "rgba(255,255,255,0.2)", "position": "absolute", "border-radius": "50%",
                        "auto-animar": { "tipo": "flotar", "intensidad": 100, "duracion": 15 }
                    },
                    "variacion": { "top": 1000, "left": 2000 }
                }
            }
        },

        "GLOBAL_NAV": {
            "position": "fixed", "top": "0", "width": "100%", "padding": "30px 60px", "display": "flex", "justify-content": "space-between", "align-items": "center", "z-index": "10000", "background": "linear-gradient(to bottom, rgba(3,0,20,0.8), transparent)",
            "LOGO": {
                "texto": "IMPULSA<span style='color:#0ea5e9'>.V4</span>", "font-size": "1.2rem", "font-weight": "900", "letter-spacing": "2px", "cursor": "pointer",
                "hover": { "transform": "scale(1.1)", "color": "#0ea5e9" }
            },
            "LINKS": {
                "display": "flex", "gap": "40px",
                "l1": { "texto": "Servicios", "font-size": "13px", "font-weight": "600", "opacity": "0.6", "cursor": "pointer", "hover": { "opacity": "1", "color": "#0ea5e9" } },
                "l2": { "texto": "Showcase", "font-size": "13px", "font-weight": "600", "opacity": "0.6", "cursor": "pointer", "hover": { "opacity": "1", "color": "#0ea5e9" } },
                "l3": { "texto": "Arquitectura", "font-size": "13px", "font-weight": "600", "opacity": "0.6", "cursor": "pointer", "hover": { "opacity": "1", "color": "#0ea5e9" } }
            }
        },

        "CONTENT_SCROLLER": {
            "display": "flex", "flex-direction": "column", "width": "100%", "align-items": "center",

            "HERO_SECTION": {
                "width": "100%", "height": "100vh", "display": "flex", "flex-direction": "column", "align-items": "center", "justify-content": "center", "position": "relative", "transform-style": "preserve-3d",
                "MAIN_TITLE": {
                    "transform-style": "preserve-3d", "display": "flex", "flex-direction": "column", "align-items": "center",
                    "t1": {
                        "texto": "FUTURE", "font-size": "15vw", "font-weight": "900", "line-height": "0.8", "opacity": "0.1", "letter-spacing": "-10px", "position": "absolute", "top": "50%", "left": "50%", "transform": "translate(-50%, -50%) translateZ(-200px)"
                    },
                    "t2": {
                        "texto": "AGENCY", "font-size": "8rem", "font-weight": "900", "color": "#fff", "letter-spacing": "-2px",
                        "look-at": { "intensidad": 40 }, "transform": "translateZ(300px)"
                    },
                    "sub": {
                        "texto": "TRANSFORMACIÓN DIGITAL DE ALTA FIDELIDAD", "font-size": "1rem", "color": "#0ea5e9", "margin-top": "20px", "letter-spacing": "8px", "font-weight": "700",
                        "escribir": { "velocidad": 60, "retraso": 500 }, "transform": "translateZ(150px)"
                    }
                },
                "CORE_ORB": {
                    "width": "600px", "height": "600px", "background": "radial-gradient(circle, rgba(14, 165, 233, 0.1) 0%, transparent 60%)", "border-radius": "50%", "position": "absolute",
                    "magnetico": { "fuerza": 0.3, "radio": 800 },
                    "INNER": { "width": "20px", "height": "20px", "background": "#fff", "border-radius": "50%", "box-shadow": "0 0 50px #0ea5e9", "auto-animar": { "tipo": "latir", "intensidad": 50 } }
                }
            },

            "SERVICES_GRID": {
                "display": "grid", "grid-template-columns": "repeat(3, 1fr)", "gap": "30px", "width": "90%", "max-width": "1300px", "padding": "150px 0", "transform-style": "preserve-3d",
                "CARD_1": {
                    "background": "rgba(255,255,255,0.02)", "border": "1px solid rgba(255,255,255,0.05)", "border-radius": "40px", "padding": "60px", "cursor": "pointer", "transition": "all 0.8s cubic-bezier(0.16, 1, 0.3, 1)", "transform-style": "preserve-3d",
                    "hover": { "background": "rgba(14, 165, 233, 0.05)", "border-color": "rgba(14, 165, 233, 0.3)", "transform": "translateZ(100px) scale(1.05)" },
                    "hover-hermanos": { "opacity": "0.3", "filter": "blur(10px)", "transform": "translateZ(-50px) scale(0.95)" },
                    "ICON": { "texto": "architecture", "font-family": "'Material Icons Round'", "font-size": "3rem", "color": "#0ea5e9", "margin-bottom": "30px", "transform": "translateZ(50px)" },
                    "TITLE": { "texto": "Estrategia 3D", "font-size": "2rem", "font-weight": "800", "margin-bottom": "15px" },
                    "DESC": { "texto": "Diseñamos ecosistemas digitales con profundidad espacial y rendimiento nativo.", "font-size": "1rem", "color": "rgba(255,255,255,0.5)", "line-height": "1.6" }
                },
                "CARD_2": {
                    "background": "rgba(255,255,255,0.02)", "border": "1px solid rgba(255,255,255,0.05)", "border-radius": "40px", "padding": "60px", "cursor": "pointer", "transition": "all 0.8s cubic-bezier(0.16, 1, 0.3, 1)", "transform-style": "preserve-3d",
                    "hover": { "background": "rgba(168, 85, 247, 0.05)", "border-color": "rgba(168, 85, 247, 0.3)", "transform": "translateZ(100px) scale(1.05)" },
                    "hover-hermanos": { "opacity": "0.3", "filter": "blur(10px)", "transform": "translateZ(-50px) scale(0.95)" },
                    "ICON": { "texto": "psychology", "font-family": "'Material Icons Round'", "font-size": "3rem", "color": "#a855f7", "margin-bottom": "30px", "transform": "translateZ(50px)" },
                    "TITLE": { "texto": "IA Cognitiva", "font-size": "2rem", "font-weight": "800", "margin-bottom": "15px" },
                    "DESC": { "texto": "Modelos generativos integrados que entienden y evolucionan tu interfaz.", "font-size": "1rem", "color": "rgba(255,255,255,0.5)", "line-height": "1.6" }
                },
                "CARD_3": {
                    "background": "rgba(255,255,255,0.02)", "border": "1px solid rgba(255,255,255,0.05)", "border-radius": "40px", "padding": "60px", "cursor": "pointer", "transition": "all 0.8s cubic-bezier(0.16, 1, 0.3, 1)", "transform-style": "preserve-3d",
                    "hover": { "background": "rgba(244, 63, 94, 0.05)", "border-color": "rgba(244, 63, 94, 0.3)", "transform": "translateZ(100px) scale(1.05)" },
                    "hover-hermanos": { "opacity": "0.3", "filter": "blur(10px)", "transform": "translateZ(-50px) scale(0.95)" },
                    "ICON": { "texto": "payments", "font-family": "'Material Icons Round'", "font-size": "3rem", "color": "#f43f5e", "margin-bottom": "30px", "transform": "translateZ(50px)" },
                    "TITLE": { "texto": "Fintech OS", "font-size": "2rem", "font-weight": "800", "margin-bottom": "15px" },
                    "DESC": { "texto": "Sistemas financieros transaccionales con seguridad y fluidez de grado bancario.", "font-size": "1rem", "color": "rgba(255,255,255,0.5)", "line-height": "1.6" }
                }
            },

            "SHOWCASE_INTERACTIVE": {
                "width": "100%", "padding": "100px 0", "display": "flex", "flex-direction": "column", "align-items": "center", "background": "linear-gradient(to bottom, transparent, #050505, transparent)", "transform-style": "preserve-3d",
                "SECTION_H": { "texto": "INTERACTIVE SHOWCASE", "font-size": "0.8rem", "font-weight": "900", "letter-spacing": "10px", "color": "rgba(255,255,255,0.2)", "margin-bottom": "80px" },

                "DEVICE_WRAPPER": {
                    "width": "100%", "display": "flex", "justify-content": "center", "gap": "100px", "align-items": "center", "transform-style": "preserve-3d",

                    "MOBILE_DEVICE": {
                        "width": "300px", "height": "600px", "background": "#000", "border-radius": "40px", "border": "8px solid #1a1a1a", "position": "relative", "overflow": "hidden", "box-shadow": "0 50px 100px rgba(0,0,0,0.5)", "transform": "rotateY(15deg) rotateX(10deg)",
                        "tilt": { "max": 10 },
                        "SCREEN": {
                            "width": "100%", "height": "100%", "padding": "40px 20px", "display": "flex", "flex-direction": "column",
                            "h": { "texto": "Active Assets", "font-size": "12px", "color": "#555" },
                            "v": { "texto": "$840,000", "font-size": "2rem", "font-weight": "800", "margin-top": "10px" },
                            "LIST": {
                                "margin-top": "40px", "display": "flex", "flex-direction": "column", "gap": "10px",
                                "i1": { "width": "100%", "height": "60px", "background": "rgba(255,255,255,0.05)", "border-radius": "15px", "auto-animar": { "tipo": "latir", "intensidad": 5 } },
                                "i2": { "width": "100%", "height": "60px", "background": "rgba(255,255,255,0.05)", "border-radius": "15px", "auto-animar": { "tipo": "latir", "intensidad": 5, "duracion": 4 } }
                            }
                        }
                    },

                    "EXPLODED_VIEW": {
                        "width": "400px", "height": "500px", "position": "relative", "transform-style": "preserve-3d",
                        "LAYER_1": {
                            "position": "absolute", "width": "100%", "height": "100%", "background": "rgba(14, 165, 233, 0.1)", "border": "1px solid #0ea5e9", "border-radius": "20px", "transform": "translateZ(100px)", "transition": "all 1s cubic-bezier(0.2, 0.8, 0.2, 1)", "display": "flex", "align-items": "center", "justify-content": "center",
                            "t": { "texto": "USER INTERFACE LAYER", "font-size": "0.7rem", "font-weight": "800" }
                        },
                        "LAYER_2": {
                            "position": "absolute", "width": "100%", "height": "100%", "background": "rgba(168, 85, 247, 0.1)", "border": "1px solid #a855f7", "border-radius": "20px", "transform": "translateZ(0px)", "transition": "all 1s cubic-bezier(0.2, 0.8, 0.2, 1)", "display": "flex", "align-items": "center", "justify-content": "center",
                            "t": { "texto": "ENGINE CORE V4", "font-size": "0.7rem", "font-weight": "800" }
                        },
                        "LAYER_3": {
                            "position": "absolute", "width": "100%", "height": "100%", "background": "rgba(244, 63, 94, 0.1)", "border": "1px solid #f43f5e", "border-radius": "20px", "transform": "translateZ(-100px)", "transition": "all 1s cubic-bezier(0.2, 0.8, 0.2, 1)", "display": "flex", "align-items": "center", "justify-content": "center",
                            "t": { "texto": "DATA ARCHITECTURE", "font-size": "0.7rem", "font-weight": "800" }
                        }
                    }
                },

                "ACTION_BTNS": {
                    "margin-top": "80px", "display": "flex", "gap": "20px",
                    "b1": {
                        "texto": "EXPAND ARCHITECTURE", "padding": "15px 40px", "border": "1px solid #0ea5e9", "border-radius": "100px", "font-size": "12px", "font-weight": "800", "cursor": "pointer", "transition": "all 0.3s",
                        "hover": { "background": "#0ea5e9", "color": "#000" },
                        "acciones": {
                            "click": [
                                { "target": "pagina_principal.CONTENT_SCROLLER.SHOWCASE_INTERACTIVE.DEVICE_WRAPPER.EXPLODED_VIEW.LAYER_1", "estilos": { "transform": "translateZ(250px)", "opacity": "0.3" } },
                                { "target": "pagina_principal.CONTENT_SCROLLER.SHOWCASE_INTERACTIVE.DEVICE_WRAPPER.EXPLODED_VIEW.LAYER_3", "estilos": { "transform": "translateZ(-250px)", "opacity": "0.3" } }
                            ]
                        }
                    },
                    "b2": {
                        "texto": "RESET VIEW", "padding": "15px 40px", "border": "1px solid rgba(255,255,255,0.1)", "border-radius": "100px", "font-size": "12px", "font-weight": "800", "cursor": "pointer",
                        "acciones": {
                            "click": [
                                { "target": "pagina_principal.CONTENT_SCROLLER.SHOWCASE_INTERACTIVE.DEVICE_WRAPPER.EXPLODED_VIEW.LAYER_1", "estilos": { "transform": "translateZ(100px)", "opacity": "1" } },
                                { "target": "pagina_principal.CONTENT_SCROLLER.SHOWCASE_INTERACTIVE.DEVICE_WRAPPER.EXPLODED_VIEW.LAYER_3", "estilos": { "transform": "translateZ(-100px)", "opacity": "1" } }
                            ]
                        }
                    }
                }
            },

            "FOOTER": {
                "width": "100%", "padding": "100px 0", "display": "flex", "flex-direction": "column", "align-items": "center", "border-top": "1px solid rgba(255,255,255,0.05)",
                "t": { "texto": "DESIGNED WITH IMPULSA V4", "font-size": "0.7rem", "letter-spacing": "5px", "opacity": "0.3" },
                "copy": { "texto": "© 2025 FUTURE AGENCY. TODOS LOS DERECHOS RESERVADOS.", "margin-top": "20px", "font-size": "0.6rem", "opacity": "0.2" }
            }
        }
    }
}
