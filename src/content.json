                "hover": {
                    "transform": "rotateX(5deg) rotateY(-5deg) scale(1.05)"
                },

                "titulo_fondo": {
                    "texto": "NATIVE",
                    "font-size": "12rem",
                    "font-weight": "900",
                    "color": "rgba(255, 255, 255, 0.02)",
                    "position": "absolute",
                    "top": "-50%",
                    "transform": "translateZ(-200px)",
                    "user-select": "none",
                    "white-space": "nowrap"
                },

                "titulo_principal": {
                    "texto": "Motor UI <span style='color: #fff;'>Espacial.</span>",
                    "font-size": "5.5rem",
                    "font-weight": "800",
                    "color": "transparent",
                    "background-image": "linear-gradient(135deg, #a855f7, #ec4899)",
                    "-webkit-background-clip": "text",
                    "text-align": "center",
                    "line-height": "1.1",
                    "letter-spacing": "-0.04em",
                    "transform": "translateZ(50px)",
                    "text-shadow": "0 20px 40px rgba(0,0,0,0.5)"
                },

                "subtitulo": {
                    "texto": "Renderizado DOM puro a 60FPS. Cero librerías intermedias.",
                    "font-size": "1.25rem",
                    "color": "#9ca3af",
                    "margin-top": "1.5rem",
                    "transform": "translateZ(80px)",
                    "max-width": "600px",
                    "text-align": "center",
                    "line-height": "1.6"
                }
            },

            "contenedor_botones": {
                "display": "flex",
                "gap": "1.5rem",
                "margin-top": "4rem",
                "transform": "translateZ(120px)",
                "transform-style": "preserve-3d",

                "btn_primario": {
                    "texto": "Explorar Arquitectura",
                    "padding": "1.2rem 2.5rem",
                    "background": "linear-gradient(135deg, #9333ea, #db2777)",
                    "border-radius": "999px",
                    "color": "#fff",
                    "font-weight": "600",
                    "font-size": "1rem",
                    "cursor": "pointer",
                    "border": "none",
                    "box-shadow": "0 10px 30px rgba(219, 39, 119, 0.3)",
                    "transition": "all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275)",
                    "hover": {
                        "transform": "translateZ(30px) scale(1.1)",
                        "box-shadow": "0 20px 40px rgba(219, 39, 119, 0.6)"
                    }
                },
                "btn_secundario": {
                    "texto": "Ver Código JSON",
                    "padding": "1.2rem 2.5rem",
                    "background": "rgba(255, 255, 255, 0.03)",
                    "border-radius": "999px",
                    "color": "#e5e7eb",
                    "font-weight": "600",
                    "font-size": "1rem",
                    "cursor": "pointer",
                    "border": "1px solid rgba(255,255,255,0.1)",
                    "transition": "all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275)",
                    "hover": {
                        "background": "rgba(255, 255, 255, 0.1)",
                        "transform": "translateZ(20px) scale(1.05)",
                        "border-color": "rgba(255,255,255,0.3)"
                    }
                }
            }
        },

