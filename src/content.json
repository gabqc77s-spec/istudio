{
  "pagina_principal": {
    "nombre": "V4 Master Experience",
    "display": "flex",
    "flex-direction": "column",
    "align-items": "center",
    "width": "100%",
    "min-height": "100vh",
    "background": "radial-gradient(circle at 50% 10%, #0a0a2e 0%, #030014 100%)",
    "perspective": "1500px",
    "transform-style": "preserve-3d",
    "overflow-x": "hidden",
    "transition": "background 1.5s ease",

    "global_filters": {
      "position": "fixed",
      "top": "0",
      "left": "0",
      "width": "100%",
      "height": "100%",
      "pointer-events": "none",
      "z-index": "1000",
      "background": "radial-gradient(circle at center, transparent 0%, rgba(0,0,0,0.4) 100%)",
      "mix-blend-mode": "overlay",
      "opacity": "0.5"
    },

    "header_nav": {
      "position": "fixed",
      "top": "0",
      "width": "100%",
      "display": "flex",
      "justify-content": "space-between",
      "align-items": "center",
      "padding": "2rem 4rem",
      "z-index": "1100",
      "logo": {
        "texto": "V4<span style='color: #0ea5e9;'>.MASTER</span>",
        "font-weight": "900",
        "font-size": "1.2rem",
        "letter-spacing": "0.2em",
        "color": "#fff",
        "transition": "color 0.5s ease"
      },
      "status": {
        "texto": "MULTIVERSE: ACTIVE",
        "font-size": "10px",
        "font-weight": "700",
        "color": "#0ea5e9",
        "letter-spacing": "0.1em",
        "padding": "4px 12px",
        "border": "1px solid rgba(14, 165, 233, 0.3)",
        "border-radius": "20px"
      }
    },

    "seccion_1_cyber_hero": {
      "nombre": "Cyber Hero",
      "width": "100%",
      "min-height": "110vh",
      "display": "flex",
      "flex-direction": "column",
      "align-items": "center",
      "justify-content": "center",
      "transform-style": "preserve-3d",
      "position": "relative",

      "stars_background": {
        "position": "absolute",
        "width": "100%",
        "height": "100%",
        "pointer-events": "none",
        "instancias": {
          "cantidad": 100,
          "spread": { "x": 2000, "y": 1500, "z": 1000 },
          "scale": { "min": 0.1, "max": 0.4 }
        },
        "background": "#fff",
        "border-radius": "50%",
        "box-shadow": "0 0 10px #fff"
      },

      "content_hero": {
        "display": "flex",
        "flex-direction": "column",
        "align-items": "center",
        "transform-style": "preserve-3d",
        "look-at-mouse": { "maxRotation": 15 },

        "badge": {
          "texto": "V4 CORE ENGINE",
          "font-size": "10px",
          "font-weight": "800",
          "color": "#0ea5e9",
          "padding": "6px 16px",
          "background": "rgba(14, 165, 233, 0.1)",
          "border-radius": "20px",
          "margin-bottom": "2rem",
          "transform": "translateZ(50px)"
        },

        "titulo": {
          "texto": "ARQUITECTURA<br>NATIVA.",
          "font-size": "8rem",
          "font-weight": "900",
          "color": "#fff",
          "text-align": "center",
          "line-height": "0.9",
          "letter-spacing": "-0.04em",
          "transform": "translateZ(100px)",
          "text-shadow": "0 20px 50px rgba(0,0,0,0.5)"
        },

        "sub": {
          "texto": "Un solo archivo JSON. Una experiencia infinita.",
          "font-size": "1.2rem",
          "color": "#94a3b8",
          "margin-top": "2rem",
          "transform": "translateZ(150px)"
        }
      }
    },

    "seccion_2_glass_stats": {
      "nombre": "Glass Dashboard",
      "width": "100%",
      "max-width": "1400px",
      "padding": "100px 40px",
      "display": "grid",
      "grid-template-columns": "repeat(3, 1fr)",
      "gap": "30px",
      "transform-style": "preserve-3d",

      "stat_card": {
        "instancias": {
          "cantidad": 3
        },
        "background": "rgba(255, 255, 255, 0.03)",
        "backdrop-filter": "blur(20px)",
        "border": "1px solid rgba(255, 255, 255, 0.05)",
        "border-radius": "32px",
        "padding": "40px",
        "display": "flex",
        "flex-direction": "column",
        "gap": "10px",
        "transition": "all 0.5s cubic-bezier(0.23, 1, 0.32, 1)",
        "hover": {
          "transform": "translateZ(50px) rotateX(5deg)",
          "background": "rgba(255, 255, 255, 0.08)",
          "border-color": "rgba(14, 165, 233, 0.3)"
        },
        "val": { "texto": "99.9%", "font-size": "3rem", "font-weight": "800", "color": "#fff" },
        "lab": { "texto": "Eficiencia de Render", "color": "#94a3b8", "font-size": "0.9rem" }
      },

      "chart_full": {
        "grid-column": "span 3",
        "height": "400px",
        "background": "rgba(255, 255, 255, 0.02)",
        "backdrop-filter": "blur(20px)",
        "border": "1px solid rgba(255, 255, 255, 0.05)",
        "border-radius": "40px",
        "padding": "40px",
        "display": "flex",
        "flex-direction": "column",
        "title": { "texto": "RENDIMIENTO MULTIVERSO", "font-weight": "700", "letter-spacing": "0.1em", "color": "#0ea5e9" },
        "bars_container": {
          "flex": "1",
          "display": "flex",
          "align-items": "flex-end",
          "gap": "15px",
          "margin-top": "20px",
          "bar": {
            "instancias": { "cantidad": 20 },
            "flex": "1",
            "background": "linear-gradient(to top, #0ea5e9, transparent)",
            "border-radius": "8px 8px 0 0",
            "auto-animate": { "height": "random(20%, 90%)", "duration": "3s" }
          }
        }
      }
    },

    "seccion_3_fluid_gallery": {
      "nombre": "Organic Gallery",
      "width": "100%",
      "padding": "150px 0",
      "display": "flex",
      "flex-direction": "column",
      "align-items": "center",
      "gap": "60px",

      "gallery_title": {
          "texto": "INTERACCIONES LÍQUIDAS",
          "font-size": "3rem",
          "font-weight": "800",
          "color": "#fff",
          "look-at-mouse": { "maxRotation": 10 }
      },

      "carrusel_horizontal": {
        "width": "100%",
        "display": "flex",
        "gap": "40px",
        "padding": "40px 10%",
        "scroll": { "direccion": "horizontal", "snap": true, "fade": 0.2 },
        "card_organic": {
          "instancias": { "cantidad": 6 },
          "min-width": "350px",
          "height": "500px",
          "background": "rgba(255,255,255,0.05)",
          "backdrop-filter": "blur(15px)",
          "border-radius": "80px",
          "border": "1px solid rgba(255,255,255,0.1)",
          "display": "flex",
          "flex-direction": "column",
          "align-items": "center",
          "justify-content": "center",
          "padding": "40px",
          "transition": "all 0.6s ease",
          "hover": {
            "transform": "scale(1.05) translateY(-20px)",
            "border-color": "#0ea5e9"
          },
          "blob": {
            "width": "120px",
            "height": "120px",
            "background": "linear-gradient(45deg, #0ea5e9, #a855f7)",
            "border-radius": "40% 60% 70% 30% / 40% 50% 60% 50%",
            "auto-animate": { "rotate-z": 1, "scale": 1.1 }
          },
          "t": { "texto": "Fluid UI", "margin-top": "2rem", "font-weight": "700", "font-size": "1.5rem" },
          "d": { "texto": "Dinámicas físicas procesadas en tiempo real.", "text-align": "center", "color": "#94a3b8", "font-size": "0.9rem", "margin-top": "1rem" }
        }
      }
    },

    "seccion_4_studio_footer": {
      "nombre": "Architectural Studio",
      "width": "100%",
      "padding": "100px 40px",
      "background": "#fff",
      "color": "#000",
      "display": "flex",
      "flex-direction": "column",
      "align-items": "center",
      "position": "relative",
      "transition": "all 1s ease",

      "grid_info": {
        "width": "100%",
        "max-width": "1400px",
        "display": "grid",
        "grid-template-columns": "repeat(12, 1fr)",
        "gap": "20px",
        "item_main": {
          "grid-column": "span 8",
          "padding": "60px",
          "border": "1px solid #000",
          "title": { "texto": "V4.STUDIO", "font-size": "4rem", "font-weight": "900", "letter-spacing": "-0.04em" },
          "desc": { "texto": "La evolución final del diseño basado en datos. Un futuro donde el código y el diseño son la misma entidad armoniosa.", "margin-top": "2rem", "font-size": "1.2rem", "line-height": "1.6" }
        },
        "item_side": {
          "grid-column": "span 4",
          "background": "#000",
          "color": "#fff",
          "padding": "60px",
          "display": "flex",
          "flex-direction": "column",
          "justify-content": "space-between",
          "label": { "texto": "EST. 2024", "font-size": "0.7rem", "letter-spacing": "0.3em" },
          "big": { "texto": "POESÍA ESTRUCTURAL", "font-weight": "800", "font-size": "2rem" }
        }
      },

      "footer_bottom": {
        "margin-top": "100px",
        "width": "100%",
        "max-width": "1400px",
        "display": "flex",
        "justify-content": "space-between",
        "padding": "40px 0",
        "border-top": "1px solid rgba(0,0,0,0.1)",
        "left": { "texto": "IMPULSA V4 MOTOR", "font-weight": "700", "font-size": "0.8rem" },
        "right": { "texto": "© 2024 NATIVE ARCHITECTURE", "font-size": "0.8rem" }
      }
    }
  }
}
