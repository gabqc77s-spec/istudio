{
    "pagina_principal": {
        "nombre": "App Wrapper Principal",
        "display": "flex",
        "flex-direction": "column",
        "align-items": "center",
        "width": "100%",
        "min-height": "100vh",
        "perspective": "1500px",
        "transform-style": "preserve-3d",
        "background": "radial-gradient(circle at 50% 10%, #151025 0%, #030014 100%)",
        "overflow-x": "hidden",

        "header_nav": {
            "nombre": "Barra Navegación 3D",
            "position": "fixed",
            "top": "0",
            "width": "100%",
            "max-width": "1200px",
            "display": "flex",
            "justify-content": "space-between",
            "align-items": "center",
            "padding": "1.5rem 2rem",
            "z-index": "100",
            "transform": "translateZ(100px)",
            "backdrop-filter": "blur(10px)",
            "border-bottom": "1px solid rgba(255, 255, 255, 0.05)",

            "logo": {
                "texto": "IMPULSA<span style='color: #a855f7;'>.</span>",
                "font-size": "1.5rem",
                "font-weight": "800",
                "letter-spacing": "2px",
                "cursor": "pointer",
                "transition": "transform 0.3s ease, text-shadow 0.3s ease",
                "hover": {
                    "transform": "scale(1.1) rotateX(10deg)",
                    "text-shadow": "0 0 15px rgba(168, 85, 247, 0.8)"
                }
            },
            "menu_links": {
                "display": "flex",
                "gap": "2rem",
                "link1": { "texto": "Home", "cursor": "pointer", "font-size": "0.9rem", "font-weight": "500", "color": "#a855f7", "transition": "all 0.3s ease", "hover": { "transform": "translateY(-2px)" } },
                "link2": { "texto": "Showcase", "cursor": "pointer", "font-size": "0.9rem", "font-weight": "500", "color": "#9ca3af", "transition": "all 0.3s ease", "hover": { "color": "#fff", "transform": "translateY(-2px)" } },
                "link3": { "texto": "Editor V4", "cursor": "pointer", "font-size": "0.9rem", "font-weight": "500", "color": "#9ca3af", "transition": "all 0.3s ease", "hover": { "color": "#fff", "transform": "translateY(-2px)" } }
            }
        },

        "seccion_hero": {
            "nombre": "Hero Parallax 3D",
            "position": "relative",
            "width": "100%",
            "min-height": "100vh",
            "display": "flex",
            "flex-direction": "column",
            "align-items": "center",
            "justify-content": "center",
            "transform-style": "preserve-3d",

