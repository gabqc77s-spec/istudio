        "seccion_bento_grid": {
            "nombre": "Bento Grid Reactiva",
            "width": "100%",
            "max-width": "1200px",
            "padding": "6rem 2rem",
            "margin": "0 auto",
            "display": "grid",
            "grid-template-columns": "repeat(3, 1fr)",
            "grid-auto-rows": "minmax(250px, auto)",
            "gap": "1.5rem",
            "transform-style": "preserve-3d",
            "perspective": "1000px",

            "bento_1": {
                "nombre": "Grid Larga Horizontal",
                "grid-column": "span 2",
                "background": "rgba(255,255,255,0.02)",
                "border": "1px solid rgba(255,255,255,0.05)",
                "border-radius": "24px",
                "padding": "3rem",
                "display": "flex",
                "flex-direction": "column",
                "justify-content": "flex-end",
                "position": "relative",
                "overflow": "hidden",
                "cursor": "pointer",
                "transition": "all 0.6s cubic-bezier(0.165, 0.84, 0.44, 1)",
                "hover-hermanos": {
                    "filter": "blur(4px)",
                    "opacity": "0.4",
                    "transform": "scale(0.95) translateZ(-50px)"
                },
                "hover": {
                    "transform": "translateZ(80px) scale(1.02)",
                    "background": "rgba(255,255,255,0.05)",
                    "border-color": "rgba(168, 85, 247, 0.5)",
                    "box-shadow": "0 30px 60px rgba(0,0,0,0.6), inset 0 0 20px rgba(168,85,247,0.1)"
                },

                "decoracion_bg": {
                    "position": "absolute", "top": "-50%", "right": "-10%", "width": "400px", "height": "400px",
                    "background": "radial-gradient(circle, rgba(168,85,247,0.2) 0%, transparent 70%)", "border-radius": "50%", "z-index": "0"
                },
                "t1": { "texto": "Escalabilidad", "font-size": "2rem", "font-weight": "700", "color": "#fff", "z-index": "1", "margin-bottom": "0.5rem" },
                "t2": { "texto": "Sin límite de nodos. El DOM renderiza texto y cajas infinitamente más rápido que las texturas en WebGL.", "font-size": "1rem", "color": "#9ca3af", "z-index": "1", "max-width": "80%" }
            },

            "bento_2": {
                "nombre": "Grid Cuadrada Hover",
                "background": "rgba(255,255,255,0.02)",
                "border": "1px solid rgba(255,255,255,0.05)",
                "border-radius": "24px",
                "padding": "2rem",
                "display": "flex",
                "flex-direction": "column",
                "justify-content": "space-between",
                "cursor": "pointer",
                "transition": "all 0.6s cubic-bezier(0.165, 0.84, 0.44, 1)",
                "hover-hermanos": { "filter": "blur(4px)", "opacity": "0.4", "transform": "scale(0.95) translateZ(-50px)" },
                "hover": { "transform": "translateZ(80px) scale(1.02)", "border-color": "#3b82f6", "background": "rgba(59, 130, 246, 0.05)" },

                "icon": { "texto": "🔗", "font-size": "3rem" },
                "t1": { "texto": "Data Driven", "font-size": "1.5rem", "font-weight": "700", "color": "#fff" }
            },

            "bento_3": {
                "nombre": "Grid Cuadrada Hover 2",
                "background": "rgba(255,255,255,0.02)",
                "border": "1px solid rgba(255,255,255,0.05)",
                "border-radius": "24px",
                "padding": "2rem",
                "display": "flex",
                "flex-direction": "column",
                "justify-content": "space-between",
                "cursor": "pointer",
                "transition": "all 0.6s cubic-bezier(0.165, 0.84, 0.44, 1)",
                "hover-hermanos": { "filter": "blur(4px)", "opacity": "0.4", "transform": "scale(0.95) translateZ(-50px)" },
                "hover": { "transform": "translateZ(80px) scale(1.02)", "border-color": "#10b981", "background": "rgba(16, 185, 129, 0.05)" },

                "icon": { "texto": "⚡", "font-size": "3rem" },
                "t1": { "texto": "0 Latencia", "font-size": "1.5rem", "font-weight": "700", "color": "#fff" }
            },

            "bento_4": {
                "nombre": "Grid Larga Horizontal Inferior",
                "grid-column": "span 2",
                "background": "rgba(255,255,255,0.02)",
                "border": "1px solid rgba(255,255,255,0.05)",
                "border-radius": "24px",
                "padding": "3rem",
                "display": "flex",
                "flex-direction": "column",
                "justify-content": "flex-end",
                "position": "relative",
                "overflow": "hidden",
                "cursor": "pointer",
                "transition": "all 0.6s cubic-bezier(0.165, 0.84, 0.44, 1)",
                "hover-hermanos": { "filter": "blur(4px)", "opacity": "0.4", "transform": "scale(0.95) translateZ(-50px)" },
                "hover": { "transform": "translateZ(80px) scale(1.02)", "border-color": "#f43f5e", "background": "rgba(244, 63, 94, 0.05)" },

                "t1": { "texto": "Arquitectura Purista", "font-size": "2rem", "font-weight": "700", "color": "#fff", "z-index": "1", "margin-bottom": "0.5rem" },
                "t2": { "texto": "Desarrollo agnóstico. El diseño es dictado por JSON. El renderizado es dictado por JavaScript puro. Sin intermediarios, sin cajas negras.", "font-size": "1rem", "color": "#9ca3af", "z-index": "1", "max-width": "80%" }
            }
        },

        "seccion_faq": {
            "nombre": "Acordeón Interactivo FAQ (Native Click)",
            "width": "100%",
            "max-width": "800px",
            "margin": "4rem auto",
            "padding": "0 2rem",
            "display": "flex",
            "flex-direction": "column",
            "gap": "1rem",

            "faq_1": {
                "nombre": "Pregunta 1",
                "background": "rgba(255,255,255,0.02)",
                "border": "1px solid rgba(255,255,255,0.05)",
                "border-radius": "16px",
                "padding": "1.5rem",
                "cursor": "pointer",
                "transition": "all 0.3s ease",
                "click": {
                    "background": "rgba(168,85,247,0.1)",
                    "border-color": "rgba(168,85,247,0.3)"
                },
                "hover": { "background": "rgba(255,255,255,0.05)" },

                "titulo": {
                    "texto": "¿Es realmente Vanilla JS?",
                    "font-size": "1.2rem",
                    "font-weight": "600",
                    "color": "#fff",
                    "display": "flex",
                    "justify-content": "space-between"
                },
                "contenido": {
                    "texto": "Sí. Absolutamente todo el framework de React y WebGL fue reemplazado por un motor purista V4 de menos de 400 líneas de código, que interpreta recursivamente este mismo JSON para construir la interfaz.",
                    "color": "#9ca3af",
                    "line-height": "1.6",
                    "margin-top": "0",
                    "max-height": "0",
                    "opacity": "0",
                    "overflow": "hidden",
                    "transition": "all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1)",
                    "click": {
                        "max-height": "200px",
                        "opacity": "1",
                        "margin-top": "1rem"
                    }
                }
            },
            "faq_2": {
                "nombre": "Pregunta 2",
